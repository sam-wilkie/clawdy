docs/hooks_reference.md
assets/svg-animations/prompts/
local/

# Marketing site prototype (kept local, not part of the repo)
website/

# Electron desktop pet dependencies
desktop/node_modules/

# Clawdy Kiro hooks — generated per-machine by the tray/menubar app ("Install
# Kiro Hooks"). The command inside embeds an absolute path to this machine's
# notify handler (the packaged margarita-notify.exe, or the dev venv's python),
# so it must not be committed: another clone would point at a path that doesn't
# exist. Each user regenerates it locally. The rest of .kiro/ is left to the
# project to track as it sees fit.
.kiro/hooks/clawdy.json

# Generated local artifacts: browser profiles and Python deps created by the
# SVG preview/render tooling, plus logs and pid files. Recreated on demand.
/.preview-deps/
/.edge-preview/
/.chrome-preview/
*.log
*.pid

# Local diagnostics and machine backups (may contain personal settings).
/terminal-ab-test/
/console-host-backup.json
/windows-terminal-settings-backup.json
/process-diagnostic.json
/terminal-repair-result.json
/terminal-update-verification-start.txt

# Third-party mascot art (Codex cloud) and the tool that generates it: kept
# local until permission and licensing are settled, see NOTICE.md.
/desktop/renderer/assets/codex/
/tools/codex_cloud_pixel.py
