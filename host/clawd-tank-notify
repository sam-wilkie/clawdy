#!/usr/bin/env python3
"""clawd-tank-notify — Claude Code hook handler for Clawd Tank notifications.

Reads hook payload from stdin, forwards to the Clawd Tank daemon.
Starts the daemon if not running.
"""

import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

# Ensure clawd_tank_daemon package is importable
sys.path.insert(0, str(Path(__file__).parent))

from clawd_tank_daemon.protocol import PERMISSION_WAIT_SECONDS  # noqa: E402

# CLAWD_PERMISSION_WAIT supplies a finite wait for tests/debugging.
PERMISSION_WAIT_ENV = "CLAWD_PERMISSION_WAIT"
PERMISSION_DENY_MESSAGE = "Denied from Clawdy desk window"
# Longest reply line read from the daemon; anything longer is junk.
MAX_REPLY_BYTES = 4096

CLAWD_DIR = Path.home() / ".clawd-tank"
PID_PATH = CLAWD_DIR / "daemon.pid"
# POSIX: the Unix socket itself. Windows has no AF_UNIX, so this is the file the
# daemon publishes its loopback port and shared secret in — see
# clawd_tank_daemon/socket_server.py, which has to agree on the name.
SOCKET_PATH = CLAWD_DIR / ("endpoint.json" if sys.platform == "win32" else "sock")


def _pid_alive(pid: int) -> bool:
    """Check if a process exists. Raises OSError if it cannot be determined.

    Inlined rather than imported from clawd_tank_daemon.process_utils because
    this script is deployed standalone and must stay stdlib-only.
    """
    if sys.platform == "win32":
        # os.kill(pid, 0) raises nothing for a process that has already exited
        # on Windows, so a handle to it is not enough — check the exit code.
        import ctypes

        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        # Declared explicitly: ctypes otherwise truncates the HANDLE to an int.
        kernel32.OpenProcess.argtypes = (ctypes.c_uint32, ctypes.c_int, ctypes.c_uint32)
        kernel32.OpenProcess.restype = ctypes.c_void_p
        handle = kernel32.OpenProcess(0x1000, False, pid)  # QUERY_LIMITED_INFO
        if not handle:
            return False
        try:
            code = ctypes.c_ulong()
            if not kernel32.GetExitCodeProcess(ctypes.c_void_p(handle),
                                               ctypes.byref(code)):
                return False
            return code.value == 259  # STILL_ACTIVE
        finally:
            kernel32.CloseHandle(ctypes.c_void_p(handle))
    os.kill(pid, 0)  # Check if process exists
    return True


def is_daemon_running() -> bool:
    """Check if the daemon is alive via PID file."""
    if not PID_PATH.exists():
        return False
    try:
        pid = int(PID_PATH.read_text().strip())
        alive = _pid_alive(pid)
    except (ValueError, ProcessLookupError, PermissionError, OSError):
        alive = False
    if not alive:
        # Stale PID file
        PID_PATH.unlink(missing_ok=True)
    return alive


def start_daemon() -> None:
    """Start the daemon in the background."""
    CLAWD_DIR.mkdir(parents=True, exist_ok=True)

    # Start daemon as a detached subprocess. The log file is opened in a
    # with block so it is closed promptly even if Popen raises.
    with open(CLAWD_DIR / "daemon.log", "a") as log_file:
        subprocess.Popen(
            [sys.executable, "-m", "clawd_tank_daemon.daemon", "--no-install-hooks"],
            cwd=str(Path(__file__).parent),
            stdout=log_file,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )

    # Wait for socket to appear
    for _ in range(50):  # 5 seconds max
        if SOCKET_PATH.exists():
            return
        time.sleep(0.1)

    print("Warning: daemon may not have started", file=sys.stderr)


def _permission_wait_seconds() -> float:
    try:
        value = float(os.environ.get(PERMISSION_WAIT_ENV, ""))
    except ValueError:
        return PERMISSION_WAIT_SECONDS
    return value if 0 < value < float("inf") else PERMISSION_WAIT_SECONDS


def _read_decision(sock: socket.socket, wait_seconds: float):
    """Read the daemon's one reply line and return "allow" or "deny"; None for
    anything else (no answer in time, EOF, junk, any error). Never raises and
    never returns allow unless the daemon said exactly that."""
    try:
        deadline = None if wait_seconds is None else time.monotonic() + wait_seconds
        buf = b""
        while b"\n" not in buf:
            remaining = None if deadline is None else deadline - time.monotonic()
            if remaining is not None and remaining <= 0:
                return None
            sock.settimeout(remaining)
            chunk = sock.recv(MAX_REPLY_BYTES)
            if not chunk:
                return None
            buf += chunk
            if len(buf) > MAX_REPLY_BYTES:
                return None
        reply = json.loads(buf.split(b"\n", 1)[0].decode("utf-8"))
        decision = reply.get("decision") if isinstance(reply, dict) else None
        return decision if decision in ("allow", "deny") else None
    except Exception:
        return None


def _print_decision(decision) -> None:
    """Print the PermissionRequest hook output Claude Code understands. The only
    thing this script ever writes to stdout."""
    if decision == "allow":
        outcome = {"behavior": "allow"}
    elif decision == "deny":
        outcome = {"behavior": "deny", "message": PERMISSION_DENY_MESSAGE}
    else:
        return
    sys.stdout.write(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PermissionRequest", "decision": outcome,
    }}, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def _translate_payload(payload: dict, source: str):
    """Pick the hook translator for the originating CLI.

    ``source`` comes from the ``--source`` flag the installed hook passes
    (``claude`` by default, ``codex`` or ``kiro`` for the other agents). Each
    translator emits the SAME normalized daemon message schema; they differ only
    in event vocabulary, tool-name aliases, and session-id namespacing. Returns
    None for an irrelevant hook event.
    """
    if source == "kiro":
        from clawd_tank_daemon.kiro_protocol import (
            kiro_hook_payload_to_daemon_message,
        )
        return kiro_hook_payload_to_daemon_message(payload)
    if source == "antigravity":
        from clawd_tank_daemon.antigravity_protocol import (
            antigravity_hook_payload_to_daemon_message,
        )
        return antigravity_hook_payload_to_daemon_message(payload)
    if source == "codex":
        from clawd_tank_daemon.codex_protocol import (
            codex_hook_payload_to_daemon_message,
        )
        return codex_hook_payload_to_daemon_message(payload)
    if source == "opencode":
        from clawd_tank_daemon.opencode_protocol import opencode_hook_payload_to_daemon_message
        return opencode_hook_payload_to_daemon_message(payload)
    from clawd_tank_daemon.protocol import hook_payload_to_daemon_message
    return hook_payload_to_daemon_message(payload)


def send_to_daemon(payload: dict, source: str = "claude"):
    """Send a JSON message to the daemon.

    POSIX connects straight to the Unix socket. Windows has no AF_UNIX: the
    daemon publishes a loopback port and a shared secret in SOCKET_PATH, and the
    secret goes out as the first line to authorise the connection.

    A message that asks to wait ("wait": true, PermissionRequest) keeps the
    connection open for the daemon's one-line reply: returns "allow" or "deny"
    for an explicit decision, None for everything else (and for every message
    that does not wait).
    """
    msg = _translate_payload(payload, source)
    if msg is None:
        return None  # Irrelevant hook event
    wait = msg.get("wait") is True
    decision = None

    if sys.platform == "win32":
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    else:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(3.0)
        if sys.platform == "win32":
            endpoint = json.loads(SOCKET_PATH.read_text(encoding="utf-8"))
            sock.connect(("127.0.0.1", endpoint["port"]))
            sock.sendall(endpoint["token"].encode("utf-8") + b"\n")
        else:
            sock.connect(str(SOCKET_PATH))
        # Messages are newline-delimited so the server can use readline()
        # for a reliable message boundary.
        sock.sendall(json.dumps(msg).encode("utf-8") + b"\n")
        if wait:
            decision = _read_decision(sock, _permission_wait_seconds())
    # json.JSONDecodeError and KeyError cover a torn or stale endpoint file and
    # can only arise on the Windows branch, so the POSIX failure set is unchanged.
    except (ConnectionRefusedError, FileNotFoundError, socket.timeout,
            json.JSONDecodeError, KeyError) as e:
        print(f"Failed to send to daemon: {e}", file=sys.stderr)
        # Exit 0: notifications are best-effort; a non-zero exit would
        # surface a noisy error in Claude Code for a non-critical failure.
        sys.exit(0)
    except Exception as e:
        # A waiting hook must never fail loudly or allow anything: Claude Code
        # then asks in the terminal. Other messages keep raising.
        if wait:
            print(f"Permission wait failed: {e}", file=sys.stderr)
            sys.exit(0)
        raise
    finally:
        sock.close()
    return decision


def _parse_source(argv) -> str:
    """Read the originating CLI from the first positional arg, matching the
    embedded NOTIFY_SCRIPT in clawd_tank_menubar/hooks.py: the installed hook
    passes "codex" or "kiro" as argv[1], and no arg at all means Claude Code.
    Unknown values fall back to ``claude``."""
    known = ("claude", "codex", "kiro", "opencode", "antigravity")
    value = argv[0] if argv else "claude"
    return value if value in known else "claude"


_ALLOW_SENT = False


def _write_allow() -> None:
    """Answer an Antigravity PreToolUse gate: let the agent carry on. Written at
    most once."""
    global _ALLOW_SENT
    if _ALLOW_SENT:
        return
    _ALLOW_SENT = True
    try:
        sys.stdout.write('{"decision":"allow"}\n')
        sys.stdout.flush()
    except Exception:
        pass


def _main_antigravity(event: str) -> None:
    """Antigravity hook entry point: `clawd-tank-notify antigravity <Event>`.

    The payload on stdin does not name its event, so the installed command
    passes it as an argument and it is injected as ``hookEventName``. PreToolUse
    is a gating hook: this script always answers {"decision":"allow"} (it only
    observes, it must never block the agent) and always exits 0, whatever goes
    wrong (daemon down, junk stdin, an unexpected error).
    """
    gate = event == "PreToolUse"
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else None
        if gate:
            _write_allow()
        if isinstance(payload, dict):
            if event:
                payload.setdefault("hookEventName", event)
            if not is_daemon_running():
                start_daemon()
            send_to_daemon(payload, "antigravity")
    except BaseException:
        pass
    finally:
        if gate:
            _write_allow()
    sys.exit(0)


def main():
    source = _parse_source(sys.argv[1:])
    if source == "antigravity":
        _main_antigravity(sys.argv[2] if len(sys.argv) > 2 else "")

    # Read hook payload from stdin
    try:
        raw = sys.stdin.read()
        if not raw.strip():
            sys.exit(0)
        payload = json.loads(raw)
    except json.JSONDecodeError:
        # Stdin that is not JSON has nothing to forward. Exit 0 (silent) rather
        # than 1: this is a fire-and-forget notifier, and a non-zero exit makes
        # Codex report "Hook failed, exited with code 1" for no benefit.
        sys.exit(0)

    # Ensure daemon is running
    if not is_daemon_running():
        start_daemon()

    # Forward to daemon; a permission decision (if any) is the only stdout.
    _print_decision(send_to_daemon(payload, source))


if __name__ == "__main__":
    main()
